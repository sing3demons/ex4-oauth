# Server Configuration
PORT=8080
HOST=localhost
ENV=development

# Database Configuration
DATABASE_URL=auth.db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-with-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# OAuth2 Server Configuration
OAUTH2_ISSUER=ex4-oauth2
OAUTH2_BASE_URL=http://localhost:8080

# Token Introspection Client Configuration (Optional)
INTROSPECTION_CLIENT_ID=introspection-client
INTROSPECTION_CLIENT_SECRET=change-this-introspection-secret

# Google OAuth2 Configuration (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_REDIRECT_URL=http://localhost:8080/api/auth/oauth/google/callback

# Security Configuration
BCRYPT_COST=12
RATE_LIMIT_PER_MIN=60

# CORS Configuration
ALLOWED_ORIGIN_1=http://localhost:3000
ALLOWED_ORIGIN_2=http://localhost:3001
ALLOWED_ORIGIN_3=https://yourdomain.com

# SMTP Email Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@yourapp.com
FROM_NAME=Your App Name

# Email Content Configuration
SITE_NAME=Your App
SUPPORT_EMAIL=support@yourapp.com
COMPANY_NAME=Your Company

# Admin Configuration
DEFAULT_ADMIN_EMAIL=admin@yourapp.com
DEFAULT_ADMIN_PASSWORD=change-this-strong-password

# Audit & Compliance Configuration
AUDIT_LOG_RETENTION_DAYS=90
COMPLIANCE_MODE=gdpr
ENABLE_SECURITY_ALERTS=true
SECURITY_ALERT_EMAIL=security@yourapp.com

# Production Security (Enable for production)
# SECURE_COOKIES=true
# HTTPS_ONLY=true
# TRUSTED_PROXIES=192.168.1.0/24
# SESSION_DOMAIN=.yourdomain.com